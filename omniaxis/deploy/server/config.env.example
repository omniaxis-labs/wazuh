# SCDC server settings. Copy to /etc/omniaxis-scdc/config.env (root, 0600)
# and fill in. No secrets belong here: passwords and keys are generated on
# the server into their own root-only files.
#
# Hosting is US only (Hetzner Ashburn, near Neon us-east-1). Never an
# Australian region.

# Public name of the intake relay (the only public endpoint). DNS A/AAAA
# records must point at this server before install, so Caddy can get a
# certificate. The owner creates the record.
SCDC_INTAKE_HOSTNAME=intake.security.omniaxislabs.com

# Contact address for the certificate authority (Let's Encrypt).
ACME_EMAIL=security@omniaxislabs.com

# Staff portal endpoint for alert hand-off (SEV3 and up).
PORTAL_URL=https://admin.omniaxislabs.com/api/wazuh/alerts
PORTAL_KEY_ID=scdc-wazuh-1
# This Wazuh deployment's environment; the portal binds the key to it.
SCDC_ENVIRONMENT=production

# Who may reach SSH (22/tcp). Space-separated CIDRs. Leave empty only if
# SSH is reached over Tailscale (TAILSCALE=yes); never 0.0.0.0/0.
ADMIN_SSH_CIDRS="203.0.113.10/32"

# Hosts that run Wazuh agents (1514/tcp events, 1515/tcp enrolment).
# The gate host's public address goes here.
AGENT_CIDRS="198.51.100.20/32"

# Dashboard access: "tunnel" binds it to 127.0.0.1:8443 only (reach it with
# an SSH tunnel or `tailscale serve`); "allowlist" also opens 8443 to
# DASHBOARD_CIDRS. Never public.
DASHBOARD_ACCESS=tunnel
DASHBOARD_CIDRS=""

# yes = also allow everything on the tailscale0 interface (SSH, dashboard).
TAILSCALE=no

# Pinned versions. Wazuh packages come from the official signed apt
# repository; Node from nodejs.org with its SHA-256 checked.
WAZUH_SERIES=4.14
WAZUH_VERSION=4.14.9
NODE_VERSION=24.22.1

# Optional: SHA-256 of wazuh-install.sh for this series. When set, the
# installer refuses a download that does not match.
WAZUH_INSTALL_SHA256=""
